{
  "uid": "postgres-performance-lab",
  "title": "PostgreSQL Performance Lab",
  "tags": [
    "performance",
    "postgresql",
    "fastapi"
  ],
  "schemaVersion": 41,
  "version": 1,
  "timezone": "browser",
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "database",
        "label": "База данных",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "lab-prometheus"
        },
        "query": "label_values(pg_stat_database_xact_commit{job=\"postgres\",datname!=\"\"}, datname)",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "includeAll": true,
        "allValue": ".+",
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Задержка API",
      "description": "Перцентили полной длительности запроса по варианту API.",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, variant) (label_replace(rate(lab_http_request_duration_seconds_bucket{job=\"api\",route=~\"/api/v1/(baseline|optimized)/.*\"}[$__rate_interval]), \"variant\", \"$1\", \"route\", \"/api/v1/(baseline|optimized)/.*\")))",
          "legendFormat": "p50 {{variant}}",
          "range": true
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, variant) (label_replace(rate(lab_http_request_duration_seconds_bucket{job=\"api\",route=~\"/api/v1/(baseline|optimized)/.*\"}[$__rate_interval]), \"variant\", \"$1\", \"route\", \"/api/v1/(baseline|optimized)/.*\")))",
          "legendFormat": "p95 {{variant}}",
          "range": true
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le, variant) (label_replace(rate(lab_http_request_duration_seconds_bucket{job=\"api\",route=~\"/api/v1/(baseline|optimized)/.*\"}[$__rate_interval]), \"variant\", \"$1\", \"route\", \"/api/v1/(baseline|optimized)/.*\")))",
          "legendFormat": "p99 {{variant}}",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Запросы API в секунду",
      "description": "Завершённые HTTP-запросы по варианту API.",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (variant) (label_replace(rate(lab_http_requests_total{job=\"api\",route=~\"/api/v1/(baseline|optimized)/.*\"}[$__rate_interval]), \"variant\", \"$1\", \"route\", \"/api/v1/(baseline|optimized)/.*\"))",
          "legendFormat": "{{variant}}",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Доля ошибок API 5xx",
      "description": "Доля HTTP 5xx среди всех запросов варианта.",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by (variant) (label_replace(rate(lab_http_requests_total{job=\"api\",route=~\"/api/v1/(baseline|optimized)/.*\",status=~\"5..\"}[$__rate_interval]), \"variant\", \"$1\", \"route\", \"/api/v1/(baseline|optimized)/.*\")) or (0 * sum by (variant) (label_replace(rate(lab_http_requests_total{job=\"api\",route=~\"/api/v1/(baseline|optimized)/.*\"}[$__rate_interval]), \"variant\", \"$1\", \"route\", \"/api/v1/(baseline|optimized)/.*\")))) / sum by (variant) (label_replace(rate(lab_http_requests_total{job=\"api\",route=~\"/api/v1/(baseline|optimized)/.*\"}[$__rate_interval]), \"variant\", \"$1\", \"route\", \"/api/v1/(baseline|optimized)/.*\"))",
          "legendFormat": "{{variant}}",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Длительность SQL",
      "description": "p95 вызовов SQLAlchemy и среднее время выполнения запросов из выборки pg_stat_statements.",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(lab_sql_query_duration_seconds_bucket{job=\"api\",outcome=\"ok\"}[$__rate_interval])))",
          "legendFormat": "p95 SQLAlchemy",
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum(rate(pg_stat_statements_seconds_total{job=\"postgres\",datname=~\"$database\"}[$__rate_interval])) / sum(rate(pg_stat_statements_calls_total{job=\"postgres\",datname=~\"$database\"}[$__rate_interval]))",
          "legendFormat": "Среднее PostgreSQL",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Соединения PostgreSQL и пул API",
      "description": "Активные сессии БД и занятые соединения относительно суммарной ёмкости пулов API.",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (datname) (pg_stat_activity_count{job=\"postgres\",datname=~\"$database\",state=\"active\"})",
          "legendFormat": "Активные PostgreSQL · {{datname}}",
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum(lab_db_pool_checked_out{job=\"api\"})",
          "legendFormat": "Занято в пуле API",
          "range": true
        },
        {
          "refId": "C",
          "expr": "sum(lab_db_pool_capacity{job=\"api\"})",
          "legendFormat": "Ёмкость пула API",
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Медленные запросы PostgreSQL",
      "description": "Пять идентификаторов запросов с наибольшим средним временем выполнения за интервал.",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(5, (rate(pg_stat_statements_seconds_total{job=\"postgres\",datname=~\"$database\"}[$__rate_interval]) / rate(pg_stat_statements_calls_total{job=\"postgres\",datname=~\"$database\"}[$__rate_interval])) and (rate(pg_stat_statements_calls_total{job=\"postgres\",datname=~\"$database\"}[$__rate_interval]) > 0))",
          "legendFormat": "{{datname}} · {{queryid}}",
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Транзакции PostgreSQL в секунду",
      "description": "Скорость фиксации и отката транзакций по БД.",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(pg_stat_database_xact_commit{job=\"postgres\",datname=~\"$database\"}[$__rate_interval])",
          "legendFormat": "Commit · {{datname}}",
          "range": true
        },
        {
          "refId": "B",
          "expr": "rate(pg_stat_database_xact_rollback{job=\"postgres\",datname=~\"$database\"}[$__rate_interval])",
          "legendFormat": "Rollback · {{datname}}",
          "range": true
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Доля попаданий Redis-кэша",
      "description": "Доля HIT среди HIT и MISS по аналитическим операциям.",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation) (rate(analytics_cache_requests_total{job=\"api\",outcome=\"hit\"}[$__rate_interval])) / sum by (operation) (rate(analytics_cache_requests_total{job=\"api\",outcome=~\"hit|miss\"}[$__rate_interval]))",
          "legendFormat": "{{operation}}",
          "range": true
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "CPU контейнера API",
      "description": "Время работы CPU контейнера в секунду. 100% соответствует одному ядру.",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(lab_container_cpu_seconds_total{job=\"api\"}[$__rate_interval])",
          "legendFormat": "API",
          "range": true
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Память контейнера API",
      "description": "Текущее потребление памяти cgroup контейнера API, включая файловый кэш.",
      "datasource": {
        "type": "prometheus",
        "uid": "lab-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "lab_container_memory_bytes{job=\"api\"}",
          "legendFormat": "API",
          "range": true
        }
      ]
    }
  ]
}
