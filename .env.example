# Local Compose ports and credentials.
API_PORT=8008
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
POSTGRES_DB=performance_lab
POSTGRES_USER=lab
POSTGRES_PASSWORD=lab-local-password
REDIS_HOST=127.0.0.1
REDIS_PORT=56379
REDIS_TIMEOUT=0.25
REDIS_MAX_CONNECTIONS=64
ANALYTICS_CACHE_ENABLED=true
ANALYTICS_CACHE_TTL=60
ANALYTICS_CACHE_WAIT=5
ANALYTICS_CACHE_NAMESPACE=lab

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=5
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=30000
API_PROFILING_ENABLED=false
API_METRICS_ENABLED=true
WEB_CONCURRENCY=1
HEALTHCHECK_TIMEOUT=2
LAB_MODE=false

# Optional monitoring profile, published on loopback.
PROMETHEUS_PORT=9098
GRAFANA_PORT=3008
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=lab-grafana-password
POSTGRES_EXPORTER_PASSWORD=lab-exporter-password
