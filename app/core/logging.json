{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "json": {"()": "app.core.logging.JsonFormatter"}
  },
  "handlers": {
    "stderr": {
      "class": "logging.StreamHandler",
      "formatter": "json",
      "stream": "ext://sys.stderr"
    }
  },
  "root": {"level": "INFO", "handlers": ["stderr"]}
}
